# Pulsar Server
PORT=8888
CORS_ORIGIN=*

# LLM Engine (choose one: ollama, openai, google, claude)
ENGINE_TYPE=ollama

# Ollama (local, no API key needed)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI / compatible API
OPENAI_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Anthropic Claude
CLAUDE_URL=https://api.anthropic.com
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Agent Identity
AGENT_ID=
AGENT_NAME=My Agent
AGENT_EMOJI=🤖
AGENT_COLOR=#6C5CE7
AGENT_SYSTEM=

# Pulsar Server URL (for remote connection)
PULSAR_SERVER=ws://localhost:8888
